# Credenciales para firmar y notarizar Tamio (macOS).
#
# CÓMO USAR:
#   1. Copia este archivo a  .env.firma   (ese sí queda ignorado por git).
#   2. Rellena los 4 valores con los tuyos (ver docs/firma-apple.md).
#   3. Corre:  npm run firmar
#
# NUNCA subas .env.firma a git. Aquí NO pongas valores reales.

# Identidad de firma. Sácala con:  security find-identity -v -p codesigning
# Se ve así (con tus datos):  "Developer ID Application: Tu Nombre (ABCDE12345)"
export APPLE_SIGNING_IDENTITY="Developer ID Application: TU NOMBRE (TU_TEAM_ID)"

# Tu Apple ID (el correo de tu cuenta de desarrollador).
export APPLE_ID="tu-correo@ejemplo.com"

# Contraseña específica de app (NO tu contraseña normal).
# Se genera en appleid.apple.com → Seguridad → Contraseñas específicas de app.
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Tu Team ID (10 caracteres). Aparece en developer.apple.com → Membership.
export APPLE_TEAM_ID="TU_TEAM_ID"
