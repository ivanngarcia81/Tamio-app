{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "fs-escritorio",
  "description": "Qué carpetas puede leer y escribir la app en Mac/Windows/Linux. Antes era $HOME/** entero — toda la carpeta del usuario, incluidas ~/.ssh, ~/Library (llaveros, cookies, correo) y los perfiles del navegador. Nada de eso tiene que ver con la tesorería de una iglesia.",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$PICTURE/**" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$PICTURE/**" }
      ]
    }
  ]
}
