# Copia este archivo como .env y pega tus credenciales de Supabase.
# El anon key es público/seguro para el cliente. NUNCA pongas aquí la
# service_role key ni la contraseña de la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...tu-anon-key...

# ----------------------------------------------------------------------------
# VITE_CANAL — NO lo pongas aquí. Se pone DELANTE del comando, por build:
#
#   npm run firmar:manual                 → .dmg de descarga directa
#   VITE_CANAL=appstore npm run dist:appstore   → Mac App Store / iOS
#
# En el canal `appstore` desaparecen el enlace de compra (regla 3.1.1) y el
# aviso de versión nueva (2.5.2), pase lo que pase con las variables de abajo.
# Ponerlo en el .env lo dejaría fijo para TODOS los builds, incluidos los .dmg,
# que se quedarían sin aviso de actualización sin que nadie lo notara.
# `npm run build` comprueba solo que el bundle corresponde al canal pedido.
# ----------------------------------------------------------------------------

# Enlace del checkout de Lemon Squeezy (Fase 1 de docs/guia-lemon-squeezy.md).
# Es lo que abren los botones "Comprar" y "Renovar". Si se deja vacío o sin
# poner, esos botones NO aparecen y la app no se queja: se ve entera y sin
# forma de pagar. Se lee al COMPILAR — cambiarlo obliga a recompilar.
#
# La tienda está encendida desde el 18 ago 2026 y este es el enlace real del
# plan mensual, el mismo que sirve tamio.church. No es un secreto: está
# publicado en la página. El anual es .../checkout/buy/6836ff75-6173-401f-954a-96ae87a4aad8
#
# En un build de App Store esto se ignora (VITE_CANAL=appstore lo fuerza a
# null, regla 3.1.1), así que dejarlo puesto aquí no compromete ese canal.
VITE_URL_COMPRA=https://tamio1.lemonsqueezy.com/checkout/buy/b94288df-8c4d-4e3c-973a-d5f891124f82
