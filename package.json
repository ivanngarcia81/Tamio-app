{
  "name": "tamio",
  "private": true,
  "version": "1.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verificar-csp.mjs && tsc && vite build && node scripts/verificar-canal.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "dist": "tauri build --bundles dmg",
    "dist:intel": "tauri build --bundles dmg --target x86_64-apple-darwin",
    "dist:universal": "tauri build --bundles dmg --target universal-apple-darwin",
    "firmar": "bash scripts/firmar-mac.sh",
    "firmar:manual": "bash scripts/firmar-manual.sh",
    "build:appstore": "VITE_CANAL=appstore npm run build",
    "dist:appstore": "npm run verificar-rama && VITE_CANAL=appstore npx tauri build --bundles app --target universal-apple-darwin",
    "ios:appstore": "npm run verificar-rama && VITE_CANAL=appstore npx tauri ios build --export-method app-store-connect",
    "verificar-csp": "node scripts/verificar-csp.mjs",
    "verificar-hooks": "node scripts/verificar-hooks.mjs",
    "verificar-canal": "node scripts/verificar-canal.mjs",
    "verificar-invitacion": "node scripts/verificar-invitacion.mjs",
    "verificar-navegacion": "npx esbuild scripts/verificar-navegacion.ts --bundle --platform=node --format=esm --log-level=warning | node --input-type=module",
    "verificar-traducciones": "node scripts/verificar-traducciones.mjs",
    "verificar-dinero": "node --experimental-strip-types scripts/verificar-dinero.ts",
    "verificar-migracion-36": "node --no-warnings scripts/verificar-migracion-36.mjs",
    "verificar-csv-centavos": "node --experimental-strip-types scripts/verificar-csv-centavos.ts",
    "verificar-respaldo": "node --no-warnings scripts/verificar-respaldo.mjs",
    "verificar-estado-financiero": "node --experimental-strip-types --no-warnings scripts/verificar-estado-financiero.ts",
    "verificar-centavos": "npm run verificar-dinero && npm run verificar-migracion-36 && npm run verificar-csv-centavos && npm run verificar-respaldo && npm run verificar-estado-financiero",
    "verificar-rama": "node scripts/verificar-rama.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
